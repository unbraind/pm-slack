      created_at: "2026-11-15T15:10:42.441Z"
      source_kind: local_mutation
      source_ref: ci/quick-pr-tier-deep-local-tier
  - command: PM_TEST_DEPTH=quick PM_TEST_TIME_SCALE=3 npm run coverage
    scope: project
    timeout_seconds: 1200
