{"ts":"2026-08-22T17:50:42.152Z","author":"ox-alpha","author_source":"asserted","agent_harness":"pi","agent_model":"stealth/ox-alpha","agent_model_source":"environment","agent_instance":"a2df824cf09ba38aef9c6b63","agent_provenance":{"model":{"value":"stealth/ox-alpha","source":"environment"},"effort":null,"role":{"value":"implementer","source":"argv"},"topic":null},"op":"create","patch":[{"op":"add","path":"/metadata/id","value":"pm-slack-kaku"},{"op":"add","path":"/metadata/title","value":"Drop inert pm manifest key and guard the closed manifest vocabulary"},{"op":"add","path":"/metadata/description","value":"pm-cli treats the extension manifest vocabulary as a closed set of keys; since pm-cli 2026.8.19 any other top-level manifest.json key yields a manifest_unknown_key warning. This repo's manifest.json carried an inert top-level pm key ({\"compatibility\":\"v2\"}) that nothing in src/, scripts/, or test/ ever read. It caused strict-assertion failures downstream (unbraind/pm-linear PRs #75/#76 expect findings codes exactly ['pm_min_version_unmet'] but got ['manifest_unknown_key','pm_min_version_unmet']). This change deletes only that key, bumps the dev-dependency pin of @unbrained/pm-cli from 2026.8.15 to 2026.8.22 so the regression test can detect unknown manifest keys (the older CLI predates the detection), and adds test/manifest-vocabulary.test.ts asserting zero manifest_unknown_key findings. The changelog scripts already carried unbounded-read --pm-arg flags, so no script changes were needed."},{"op":"add","path":"/metadata/type","value":"Chore"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":2},{"op":"add","path":"/metadata/tags","value":[]},{"op":"add","path":"/metadata/created_at","value":"2026-08-22T17:50:42.152Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-08-22T17:50:42.152Z"},{"op":"add","path":"/metadata/author","value":"ox-alpha"}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"e91fbb9f398077167cf9226ba1d52bfe836e38fe5ca2089aa3bb721946086424","item_hash_version":2,"message":""}
