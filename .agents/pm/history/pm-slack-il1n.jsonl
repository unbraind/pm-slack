{"ts":"2026-07-30T21:59:31.627Z","author":"codex","author_source":"configured","agent_harness":"claude-code","agent_instance":"84b5902c82cfb6f0ce1b3c16","agent_provenance":{"model":null,"effort":{"value":"xhigh","source":"environment"}},"op":"create","patch":[{"op":"add","path":"/metadata/id","value":"pm-slack-il1n"},{"op":"add","path":"/metadata/title","value":"Release commits discard the rebuilt dist, so the git-install path serves the previous version"},{"op":"add","path":"/metadata/description","value":"This package tracks dist in git on purpose: a git-URL install copies the repo as-is and never runs a build, so the entry file has to already be there. The release job rebuilds it and then throws it away - the commit step stages the manifest, lockfile, sources and changelog, and never dist. The committed output has therefore been stamped one release behind since that path was written, and the static analysers that read generated output review stale code. Stage the rebuilt tree at release time, and add a CI step that rebuilds and fails on any difference so drift cannot return between releases."},{"op":"add","path":"/metadata/type","value":"Issue"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":1},{"op":"add","path":"/metadata/tags","value":["area:release","ci"]},{"op":"add","path":"/metadata/created_at","value":"2026-07-30T21:59:31.627Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-07-30T21:59:31.627Z"},{"op":"add","path":"/metadata/author","value":"codex"},{"op":"add","path":"/metadata/acceptance_criteria","value":"The release commit stages dist whenever it is tracked; a CI step rebuilds and fails when the committed tree differs; the committed output carries the current version"}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"fed14cf09add2ebc1ef1838e9f4a5de06746049bfc1a258e68ce2b56d90e334f","message":""}
