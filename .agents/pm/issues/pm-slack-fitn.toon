  - command: "node --input-type=module -e 'import assert from '\"'\"'node:assert/strict'\"'\"';\nimport { readFileSync } from '\"'\"'node:fs'\"'\"';\nimport { execFileSync } from '\"'\"'node:child_process'\"'\"';\nimport { decode } from '\"'\"'@toon-format/toon'\"'\"';\nconst git = (...args) => execFileSync('\"'\"'git'\"'\"', args, { encoding: '\"'\"'utf8'\"'\"' });\nconst read = (file) => process.env.RECONCILE_PROOF_REF ? git('\"'\"'show'\"'\"', `${process.env.RECONCILE_PROOF_REF}:${file}`) : readFileSync(file, '\"'\"'utf8'\"'\"');\nconst item = (file) => decode(read(file));\nconst digestFile = '\"'\"'.agents/pm/issues/pm-slack-fitn.toon'\"'\"';\nconst duplicateFile = '\"'\"'.agents/pm/chores/pm-slack-stcv.toon'\"'\"';\nconst digest = item(digestFile);\nconst original = decode(git('\"'\"'show'\"'\"', `origin/main:${digestFile}`));\nassert.equal(digest.status, '\"'\"'blocked'\"'\"');\nassert.equal(digest.acceptance_criteria, original.acceptance_criteria);\nassert.deepEqual(digest.dependencies, original.dependencies);\nassert.match(digest.blocked_reason, /pm-slack-5fb5/);\nfor (const field of ['\"'\"'closed_at'\"'\"', '\"'\"'completed_at'\"'\"', '\"'\"'close_reason'\"'\"']) assert.equal(digest[field], undefined);\nassert.equal(decode(git('\"'\"'show'\"'\"', '\"'\"'origin/main:.agents/pm/issues/pm-slack-5fb5.toon'\"'\"')).status, '\"'\"'blocked'\"'\"');\nconst duplicate = item(duplicateFile);\nassert.equal(duplicate.status, '\"'\"'closed'\"'\"');\nassert.equal(duplicate.title, '\"'\"'Record statement coverage as duplicate of blocked pm-slack-5fb5'\"'\"');\nassert.equal(duplicate.close_reason, '\"'\"'duplicate of pm-slack-5fb5'\"'\"');\nassert.ok(duplicate.dependencies.some((edge) => edge.id === '\"'\"'pm-slack-5fb5'\"'\"'));\nconst unreleased = read('\"'\"'CHANGELOG.md'\"'\"').split('\"'\"'## Unreleased'\"'\"')[1]?.split(/\\n## /)[0] ?? '\"'\"''\"'\"';\nassert.ok(!unreleased.includes('\"'\"'Independently measure statement coverage'\"'\"'));\nassert.ok(!unreleased.includes('\"'\"'Read Slack digests through the complete SDK corpus'\"'\"'));\nassert.ok(unreleased.includes(duplicate.title));\nfor (const file of git('\"'\"'diff'\"'\"', '\"'\"'--name-only'\"'\"', '\"'\"'e4242a9'\"'\"', '\"'\"'--'\"'\"', '\"'\"'.agents/pm/history'\"'\"').trim().split('\"'\"'\\n'\"'\"').filter(Boolean)) {\nassert.ok(readFileSync(file, '\"'\"'utf8'\"'\"').startsWith(git('\"'\"'show'\"'\"', `e4242a9:${file}`)), '\"'\"'history must remain append-only'\"'\"');\n}\nfor (const file of git('\"'\"'diff'\"'\"', '\"'\"'--name-only'\"'\"', '\"'\"'origin/main'\"'\"').trim().split('\"'\"'\\n'\"'\"').filter(Boolean)) {\nassert.ok(file.startsWith('\"'\"'.agents/pm/'\"'\"') || file === '\"'\"'CHANGELOG.md'\"'\"', '\"'\"'tracker-only scope'\"'\"');\n}\ngit('\"'\"'diff'\"'\"', '\"'\"'--exit-code'\"'\"', '\"'\"'origin/main'\"'\"', '\"'\"'--'\"'\"', '\"'\"'index.ts'\"'\"', '\"'\"'scripts'\"'\"', '\"'\"'test'\"'\"', '\"'\"'package.json'\"'\"', '\"'\"'package-lock.json'\"'\"', '\"'\"'dist'\"'\"');\nconsole.log('\"'\"'Tracker evidence passed: blocked digest acceptance, retained criteria and dependencies, explicit duplicate note, append-only history, unchanged product source.'\"'\"');\n'"
    scope: project
